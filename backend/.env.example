# MedAid backend environment variables
#
# Copy this file to `.env` in this directory (backend/medaid/) and fill in the
# values you need. settings.py calls load_dotenv() on startup, so anything set
# here is picked up automatically.
#
# Every variable has a documented default UNLESS marked "REQUIRED". Read the
# per-variable notes: several keys, when left unset, do NOT raise an error -
# the related feature just silently degrades or returns nothing. Those are
# flagged with "SILENT NO-OP" below.

# ===========================================================================
# Core Django
# ===========================================================================

# REQUIRED in production. Falls back to an insecure dev placeholder when unset.
# Startup FAILS (hard error) if DJANGO_DEBUG is False and this is left as the
# placeholder, so production cannot boot without a real key.
DJANGO_SECRET_KEY=

# Default: True. Set to False in production. Turning it off also flips the
# secure-cookie / SSL-redirect / HSTS defaults below to their hardened values.
DJANGO_DEBUG=True

# Comma-separated. Default: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed CORS origins for the frontend. Default in DEBUG is a
# set of common localhost React/Django ports; in production the default is
# EMPTY, so you MUST set this to your deployed frontend origin(s) or the
# browser will block API calls.
CORS_ALLOWED_ORIGINS=

# ===========================================================================
# Database
# ===========================================================================

# REQUIRED. No default - an unset DB_ENGINE is a startup error (it used to fall
# back to SQLite silently and hide misconfigured Postgres deployments).
# Accepted values: postgres | postgresql | sqlite | sqlite3
DB_ENGINE=sqlite3

# The five settings below are only read when DB_ENGINE is postgres/postgresql.
# Each has a default (shown) used when that individual value is unset.
DB_NAME=medaid_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ===========================================================================
# LLM / AI providers
# ===========================================================================

# Primary triage + chat + report-insight model (Google Gemini).
# SILENT NO-OP if unset: no error is raised. Triage falls back to the OpenRouter
# failover model (if configured) or a safe "degraded" response; chat and report
# insights degrade to non-AI output (e.g. raw OCR text). AI quality drops
# silently rather than failing loudly.
GOOGLE_API_KEY=

# Cross-provider failover for triage AND the pool of user-selectable models.
# SILENT NO-OP if unset: OpenRouter failover is disabled and the model selector
# offers nothing, so a Gemini outage yields degraded responses with no backup.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=MedAid
OPENROUTER_MODEL_CACHE_SECONDS=14400

# Last-resort free failover model id. Must be a ZERO-COST model that supports
# response_format=json_object. Set to empty to disable OpenRouter failover.
TRIAGE_FALLBACK_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Primary triage model + sampling temperature.
DEFAULT_TRIAGE_MODEL=gemini-3.1-flash-lite
TRIAGE_MODEL_TEMPERATURE=0.4

# NVIDIA vision model used to analyse uploaded medical-report images.
# SILENT NO-OP if NVIDIA_API_KEY is unset: report image analysis is unavailable
# and uploads fall back to whatever the OCR service alone can extract.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Report-insight generation model + temperature (uses GOOGLE_API_KEY above).
REPORT_INSIGHT_MODEL=gemini-2.5-flash
REPORT_INSIGHT_TEMPERATURE=0.2

# Dietary-advice model. SILENT NO-OP if unset: dietary generation has no default
# model and will not produce AI advice until an OpenRouter free-model id is set.
DIETARY_DEFAULT_FREE_MODEL=
DIETARY_MODEL_TEMPERATURE=0.25

# ===========================================================================
# Maps / facility lookup
# ===========================================================================

# Google Places API key for nearby-facility recommendations.
# SILENT NO-OP if unset: facility lookups return NO results (the code returns
# early) - the map/nearby-care panels simply come up empty, no error.
GOOGLE_PLACES_API_KEY=

# Key for embedded map iframes. Defaults to GOOGLE_PLACES_API_KEY when unset.
MAPS_EMBED_KEY=

# ===========================================================================
# OCR microservice (Apple Vision OCR sidecar, see ocr-service/)
# ===========================================================================

# Defaults shown. OCR_SERVICE_KEY is an optional shared secret; when empty the
# backend calls the OCR service without an auth header.
OCR_SERVICE_URL=http://127.0.0.1:5050
OCR_SERVICE_KEY=
OCR_SERVICE_TIMEOUT=20

# ===========================================================================
# Cache / quota enforcement
# ===========================================================================

# Redis connection string used for cross-worker caching and shared LLM quota
# throttles. SILENT NO-OP if unset: the app uses an in-process LocMemCache, so
# global rate limits/quotas are enforced PER PROCESS. With N gunicorn workers
# every ceiling is effectively multiplied by N (a warning is logged in
# production). Set this in any multi-worker deployment.
REDIS_URL=

# ===========================================================================
# Per-endpoint LLM quota ceilings (starting estimates; tune against real usage)
# Each has a global (app-wide) and per-user ceiling. Defaults shown.
# ===========================================================================
TRIAGE_GLOBAL_RPM_LIMIT=18
TRIAGE_GLOBAL_DAILY_LIMIT=45
TRIAGE_USER_RPM_LIMIT=5
TRIAGE_USER_DAILY_LIMIT=15

CHAT_GLOBAL_RPM_LIMIT=30
CHAT_GLOBAL_DAILY_LIMIT=100
CHAT_USER_RPM_LIMIT=10
CHAT_USER_DAILY_LIMIT=30

REPORT_INSIGHT_GLOBAL_RPM_LIMIT=18
REPORT_INSIGHT_GLOBAL_DAILY_LIMIT=45
REPORT_INSIGHT_USER_RPM_LIMIT=5
REPORT_INSIGHT_USER_DAILY_LIMIT=15

DIETARY_GLOBAL_RPM_LIMIT=18
DIETARY_GLOBAL_DAILY_LIMIT=45
DIETARY_GLOBAL_ACTIVE_LIMIT=2
DIETARY_THROTTLE_SECONDS=15
DIETARY_ACTIVE_REQUEST_SECONDS=120

# ===========================================================================
# Production security toggles (defaults derive from DJANGO_DEBUG)
# When DJANGO_DEBUG=False these default to the hardened value; in DEBUG they
# default off. Override only if you need to.
# ===========================================================================
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=

# ===========================================================================
# Feature flags
# ===========================================================================

# Streamlit-reference parity endpoint (/api/reference-compat/assess/). Default
# OFF. This endpoint deliberately lacks the safety work on the primary triage
# paths (emergency short-circuit, risk floor, confidence calibration, condition
# validation) and MUST NOT serve real patients - enable only for parity testing.
ENABLE_REFERENCE_COMPAT_API=false
